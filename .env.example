# Required (public by design; your data is protected by Row Level Security, never by hiding these)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: Web Push. The PUBLIC half of your VAPID key pair (see docs/PUSH_SETUP.md). Without it Settings says notifications are not available.
VITE_VAPID_PUBLIC_KEY=

# Production only (set in Vercel -> Settings -> Environment Variables): your final address, https, no trailing slash.
# It builds sitemap.xml, robots.txt and the og:image tags. The production build fails without it.
SITE_URL=https://app.fiiyou.online

# Optional: Cloudflare Turnstile CAPTCHA on sign up / sign in (see docs/SECURITY.md, section 4). Leave empty to turn it off.
VITE_TURNSTILE_SITE_KEY=

# Optional, Vercel only (not VITE_): limits per visitor address for middleware.js. Defaults: 240 at once, then 4 a second.
# RATE_LIMIT_BURST=240
# RATE_LIMIT_PER_SECOND=4
